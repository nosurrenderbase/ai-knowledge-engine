# kbsync ayarları (bkz. apps/sync/README.md). deploy/run.sh bu dosyayı deploy/kbsync.env olarak yükler.
KB_REPO=/path/to/ai-knowledge-engine/work/kb
CODE_REPO=/path/to/ai-knowledge-engine/work/code

# node (22.18+) ve claude'un bulunduğu klasörler; launchd kabuk profilini yüklemez.
PATH_PREFIX=/path/to/node/bin:/path/to/.local/bin

GIT_AUTHOR_NAME="NoSurrender AI"
GIT_AUTHOR_EMAIL=ai@nosurrender.studio

# Botun abonelik token'ı (`claude setup-token`). Boşsa makinedeki claude girişi kullanılır.
# CLAUDE_CODE_OAUTH_TOKEN=

# Alarmlar için (ör. Slack incoming webhook). Boşsa yalnız loga yazılır.
# ALERT_WEBHOOK_URL=

# POLL_INTERVAL_MS=120000
# BATCH_THRESHOLD=3
# MAX_ATTEMPTS=3
