<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.nosurrender.kbsync</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/deploy/run.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <!-- On SIGTERM the worker tries to finish the running job, but launchd caps user agents at 60 s.
       What protects a running Claude job is the busy file: the deploy job restarts the worker only when it is absent. -->
  <key>ExitTimeOut</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>__REPO__/work/logs/kbsync.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/work/logs/kbsync.log</string>
</dict>
</plist>
