<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.nosurrender.kbsync</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/deploy/run.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <!-- On SIGTERM the worker finishes the running job first (up to CLAUDE_TIMEOUT_MS); do not kill it after the default 20 s. -->
  <key>ExitTimeOut</key>
  <integer>3900</integer>
  <key>StandardOutPath</key>
  <string>__REPO__/work/logs/kbsync.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/work/logs/kbsync.log</string>
</dict>
</plist>
